{
  "name": "dsh-cosplay",
  "version": "0.1.0",
  "description": "DSH 角色扮演插件：角色卡（人设系统提示注入 / 用户提示词改写两条链路）、预设与自定义角色卡、本地库与单文件导入导出、聊天区「角色」页签。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.1.7-rc.1 <0.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "build:client": "tsdown",
    "typecheck": "tsc --noEmit",
    "check:client": "node scripts/check-client-purity.mjs",
    "pretest": "npm run build && npm run check:client",
    "test": "node --test \"test/*.test.mjs\""
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/client.js",
    "src",
    "scripts",
    "presets",
    "cordis.patch.yml",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": ">=0.1.7-rc.1 <0.3",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.7-rc.1 <0.3",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.7-rc.1 <0.3",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.7-rc.1 <0.3",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.7-rc.1 <0.3",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.7-rc.1 <0.3",
    "@deepseek-ai/dsh-commands": ">=0.1.7-rc.1 <0.3",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-rc.1 <0.3",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1 <0.3",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.7-rc.1 <0.3",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.1",
    "@deepseek-ai/dsh-agent-default-model": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.1",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.1",
    "@deepseek-ai/dsh-package-manifest": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "0.2.0-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.1",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.3.1",
    "semver": "^7.8.5",
    "tsdown": "0.22.2",
    "typescript": "~5.7.2"
  },
  "license": "BSD-3-Clause",
  "private": true
}
